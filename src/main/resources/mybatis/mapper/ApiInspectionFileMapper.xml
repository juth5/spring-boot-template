<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="study.mapper.InspectionFileMapper">
  <insert id="insertInspectionFile">
      INSERT INTO sample1.inspection_file
        (name, description)
      VALUES
        (#{name}, #{description})
  </insert>
</mapper>